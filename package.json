{
  "name": "crack-stack",
  "version": "0.0.0",
  "description": "Choose a technology stack and generate setup skills and an application brief.",
  "bin": {
    "crack-stack": "scripts/create.mjs"
  },
  "files": [
    "scripts/",
    "skills/",
    "examples/",
    ".npm-template/",
    "catalog.json",
    "stack.json",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonHylander/crack-stack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "stack": "node scripts/stack.mjs",
    "check": "node scripts/check.mjs && tsc --noEmit && node --test scripts/*.test.mjs examples/architecture/src/task.test.ts",
    "example": "node examples/architecture/src/bootstrap.ts",
    "create": "node scripts/create.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
